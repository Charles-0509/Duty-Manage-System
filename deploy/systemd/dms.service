[Unit]
Description=Duty Management System Service
After=network.target

[Service]
User=__DMS_USER__
WorkingDirectory=__DMS_DIR__/backend
EnvironmentFile=__DMS_DIR__/backend/.env
Environment=GIN_MODE=release
ExecStart=__DMS_DIR__/personnel-management
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
