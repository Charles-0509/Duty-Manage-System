APP_PORT=3000
# Global account and semester catalog database.
CONTROL_DATABASE_PATH=../data/control.db
# Managed directory containing one SQLite database per semester.
SEMESTER_DATABASE_DIR=../data/semesters

# Legacy bootstrap sources. They are read only when control.db has not been initialized.
DATABASE_PATH=../data/personnel.db
PRIVATE_MEMBERS_PATH=../data/member.json
JWT_SECRET=please-change-me
# Access-token lifetime in seconds (default 7200 = 2h). Refresh tokens always
# live for 7 days; shorten this only for testing.
ACCESS_TOKEN_TTL=7200
DEFAULT_ADMIN_PASSWORD=admin
# Initial semester defaults used only by legacy bootstrap.
FIRST_MONDAY=20260302

# Initial semester seed used only by legacy bootstrap.
SEED=

# Work-study record templates. Put runtime DOCX templates here; do not commit them.
WORK_STUDY_TEMPLATE_DIR=../data/work-study/templates
# Initial semester content used only by legacy bootstrap.
WORK_STUDY_CONTENT=机房运维C5-569

# Backup settings. BACKUP_DIR defaults to $HOME/DMS-backup when empty.
BACKUP_DIR=
BACKUP_GIT_ENABLED=1
BACKUP_GIT_REPO=git@github.com:Charles-0509/DMS-backup.git
BACKUP_GIT_BRANCH=main
BACKUP_SSH_KEY=$HOME/.ssh/id_ed25519
BACKUP_GIT_AUTHOR_NAME="DMS Backup"
BACKUP_GIT_AUTHOR_EMAIL=dms-backup@localhost
